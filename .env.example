# Velvet Reverie - Environment Configuration Template
# Copy this file to .env and customize your settings

# ==================== Flask Application ====================
# Host address for Flask server (0.0.0.0 allows external connections)
FLASK_HOST=0.0.0.0
# Port for Flask web interface
FLASK_PORT=4879
# Delay app startup in seconds to allow external services to finish booting
STARTUP_DELAY_SECONDS=0
# Enable debug mode (True/False) - disable in production!
FLASK_DEBUG=False
# Secret key for session encryption - CHANGE THIS TO A RANDOM STRING!
FLASK_SECRET_KEY=velvet-reverie-secret-key
# Session lifetime in days for "remember me" feature
SESSION_LIFETIME_DAYS=30

# Click "Advanced" and "Proceed" to accept - this is safe for local use

# ==================== Authentication ====================
# Password hash for login (SHA256)
# To generate: python -c "import hashlib; print(hashlib.sha256('YOUR_PASSWORD'.encode()).hexdigest())"
# Default is "password" - CHANGE THIS!
PASSWORD_HASH=f9031e664507bef426d72ed433ed4a07d47aefa362285b757186c6f8a7a1bf76

# ==================== ComfyUI Configuration ====================
# ComfyUI server address
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
# ComfyUI API token (if password protection is enabled)
# Leave empty if no authentication required
COMFYUI_TOKEN=

# ==================== Ollama Configuration ====================
# Ollama server address for AI chat/story generation
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434

# ==================== ChatterBox TTS Configuration ====================
# Host and port for the chatterbox_server.py subprocess.
# This server is started automatically by the app on first TTS request -
# you do NOT need to launch it manually.
# Only change these if port 8765 is already in use on your machine.
GRADIO_HOST=127.0.0.1
GRADIO_PORT=8765

# ==================== Paths & Directories ====================
# Output directory for generated media
OUTPUT_DIR=outputs
# User-managed input library root (images/videos for generation)
INPUT_DIR=input
# Dedicated input folder for TTS reference audio browser modal
TTS_AUDIO_INPUT_DIR=input/audio_tts
# Directory containing ComfyUI workflow JSON files
WORKFLOWS_DIR=workflows

# ComfyUI file paths (adjust if ComfyUI is installed elsewhere)
# Note: COMFYUI_INPUT_DIR is used as a temporary staging area during generation.
COMFYUI_INPUT_DIR=../ComfyUI/input/
COMFYUI_OUTPUT_DIR=../ComfyUI/output/
# Temporary staging folder under COMFYUI_INPUT_DIR for files copied from INPUT_DIR/OUTPUT_DIR
COMFYUI_TEMP_INPUT_SUBDIR=_staged

# Default placeholder image in INPUT_DIR used for text-to-image workflows
DEFAULT_INPUT_IMAGE=example.png

# Documentation directory for AI instructions
DOCS_DIR=docs

# Specific workflow file paths (relative to WORKFLOWS_DIR or absolute)
WORKFLOW_QWEN=Qwen_Full (API).json
WORKFLOW_VIDEO=Wan2.2 I2V (API).json
WORKFLOW_VIDEO_NSFW=Wan2.2 I2V NSFW (API).json

# ==================== Queue & Processing ====================
# Maximum number of completed jobs to keep in history
MAX_COMPLETED_HISTORY=50
# Note: QUEUE_START_PAUSED and AUTO_UNLOAD_MODELS are controlled via the web UI

# ==================== Pinterest Scraper ====================
# Path to Pinterest session cookies JSON file (for authenticated scraping)
# Generate this file using: py setup_pinterest.py  OR  py pinterest_client.py --login
# The file stores your Pinterest session so scraping doesn't require logging in each time
# IMPORTANT: Never commit this file to version control - it contains session credentials!
PINTEREST_COOKIES_PATH=pinterest_cookies.json
# Path to a large reference image collection for Pinterest dedup baseline
# When dedup is enabled, downloaded images are compared against this folder too
# Leave empty to only compare against existing Pinterest subfolders
PINTEREST_DEDUP_BASE_FOLDER=

# ==================== Pushover Notifications ====================
# Pushover API credentials for mobile push notifications on job completion
# Create an application at https://pushover.net/apps to get an API token
# Find your user key at https://pushover.net
# Leave both empty to disable Pushover
PUSHOVER_USER_KEY=
PUSHOVER_APP_KEY=
